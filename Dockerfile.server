FROM rust:1.75-alpine AS builder

WORKDIR /build

RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    pkgconfig

ENV OPENSSL_STATIC=1
ENV OPENSSL_LIB_DIR=/usr/lib
ENV OPENSSL_INCLUDE_DIR=/usr/include

COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

RUN cargo build --release --bin proof-server

FROM alpine:3.19

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /build/target/release/proof-server ./proof-server
COPY examples/ ./examples/
COPY regulatory/ ./regulatory/

RUN mkdir -p /data

ENV PROOF_DB=/data/proof.db
ENV PROOF_SPECS_DIR=/app/examples
ENV RUST_LOG=proof_server=info

EXPOSE 3001
CMD ["./proof-server"]